# API host only: the website is served by Vercel from ne-pulse.com.
# Caddy obtains TLS automatically and proxies HTTP + WebSockets.
api.{$DOMAIN:ne-pulse.com} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080 {
		# The backend is started with -client-ip-header X-Real-IP; Caddy
		# overwrites whatever the client sent.
		header_up X-Real-IP {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
	log {
		output file /var/log/caddy/nepulse-api.log {
			roll_size 50MiB
			roll_keep 5
		}
		# Access logs would contain client IPs; keep only what operations need.
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}
