# NE-PULSE website build configuration (Vercel project settings).
# NEXT_PUBLIC_* values are compiled into the public bundle: never put secrets here.

# Backend origin (HTTP); the WebSocket URL is derived (https -> wss).
NEXT_PUBLIC_API_URL=https://api.ne-pulse.com

# Optional: a keyed basemap provider instead of the default Esri Dark Gray canvas.
# NEXT_PUBLIC_TILE_URL=https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_TILE_LABELS_URL=
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# NEXT_PUBLIC_TILE_HOST=https://api.maptiler.com
