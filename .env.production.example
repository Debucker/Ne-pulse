# NE-PULSE backend configuration. Copy to /etc/nepulse/nepulse.env (systemd)
# or set as environment variables on your host (Render, Fly, Docker).
# Every flag of nepulse-server can be set as NEPULSE_<FLAG>.

# --- Required secrets (generate with: openssl rand -base64 48) ---
NEPULSE_SECRET=
NEPULSE_ADMIN_TOKEN=

# --- Networking ---
NEPULSE_ALLOWED_ORIGINS=https://ne-pulse.com,https://www.ne-pulse.com
NEPULSE_PUBLIC_URL=https://ne-pulse.com
# Trust exactly one proxy-set header. Behind Caddy (deploy/Caddyfile): X-Real-IP.
# Behind Cloudflare: CF-Connecting-IP. Directly exposed: leave empty.
# Never trust a header the client can set itself.
NEPULSE_CLIENT_IP_HEADER=X-Real-IP

# --- Alerts (optional). Messages always say "not an official warning". ---
NEPULSE_TELEGRAM_TOKEN=
NEPULSE_TELEGRAM_CHAT=
NEPULSE_TELEGRAM_LEVEL=confirmed
NEPULSE_WEBHOOK_URL=
NEPULSE_WEBHOOK_LEVEL=corroborated

# --- Validation catalogue (USGS + EMSC), default region = coverage + 3 degrees ---
NEPULSE_CATALOG=true
NEPULSE_CATALOG_MIN_MAG=2.5

# --- Abuse limits (defaults shown). Mobile carriers share one IP among many
# users (CGNAT), so per-IP limits stay generous; proof of work is the main
# brake on mass enrollment. Raise NEPULSE_POW_DIFFICULTY (each +1 doubles the
# work) if the operator console shows an enrollment flood.
NEPULSE_POW_DIFFICULTY=18
NEPULSE_ENROLL_PER_IP_HOUR=300
NEPULSE_MAX_CONNS_PER_IP=1000

# --- Research (optional): append pipeline evidence for replay ---
# NEPULSE_EVIDENCE_LOG=/var/lib/nepulse/evidence.jsonl
